<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
:root{--bg:#fafaf8;--fg:#1d1d1b;--muted:#5f5f5a;--card:#ffffff;--line:#deddd6;--accent:#1f5fa8;
--ok:#1e6b3a;--ok-bg:#e3f2e8;--warn:#8a5a00;--warn-bg:#fbefd6;--bad:#9b2226;--bad-bg:#f9e1e1;--code:#f1f0ec}
@media (prefers-color-scheme: dark){:root{--bg:#161615;--fg:#ebeae5;--muted:#a3a29b;--card:#1f1f1d;--line:#3a3935;
--accent:#7fb0ec;--ok:#8fd4a6;--ok-bg:#1c3326;--warn:#f0c46b;--warn-bg:#3a2f17;--bad:#f2a0a3;--bad-bg:#3d1f21;--code:#2a2a27}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:1100px;margin:0 auto;padding:16px}
a{color:var(--accent)}
h1{font-size:1.5rem;margin:.2em 0 .4em}h2{font-size:1.15rem;margin:1.6em 0 .5em;border-bottom:1px solid var(--line);padding-bottom:.2em}
h3{font-size:1rem;margin:1em 0 .3em}
.muted{color:var(--muted)}.small{font-size:.875rem}
nav{font-size:.9rem;margin-bottom:8px}nav a{margin-right:12px}
.card{background:var(--card);border:1px solid var(--line);border-radius:8px;padding:12px 14px;margin:10px 0}
.badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:.8rem;font-weight:600;white-space:nowrap}
.b-disputable{background:var(--ok-bg);color:var(--ok)}.b-valid{background:var(--code);color:var(--muted)}
.b-cannot_verify{background:var(--warn-bg);color:var(--warn)}.b-none{background:var(--code);color:var(--muted)}
.flag{background:var(--bad-bg);color:var(--bad)}
.standin{display:block;background:var(--bad-bg);color:var(--bad);border:2px solid var(--bad);border-radius:8px;padding:8px 12px;font-weight:700;margin:10px 0}
.table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
table{border-collapse:collapse;width:100%;font-size:.92rem}
th,td{text-align:left;vertical-align:top;padding:6px 8px;border-bottom:1px solid var(--line)}
th{font-weight:600;color:var(--muted);font-size:.8rem;text-transform:uppercase;letter-spacing:.03em}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
blockquote{margin:6px 0;padding:6px 12px;border-left:3px solid var(--accent);background:var(--code);border-radius:0 6px 6px 0}
code{background:var(--code);padding:1px 4px;border-radius:4px;font-size:.85em;word-break:break-all}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media (max-width:700px){.grid2{grid-template-columns:1fr}}
.kv{display:grid;grid-template-columns:max-content 1fr;gap:2px 14px}
.kv dt{color:var(--muted)}.kv dd{margin:0}
ul{padding-left:1.2em}
.wrap{overflow-wrap:anywhere}
</style>
</head>
<body>
<main>
<nav><a href="index.html">Queue</a><a href="money.html">Money</a><span class="muted small">Generated {{ generated }} · settings {{ settings_version }}</span></nav>
{% block body %}{% endblock %}
</main>
</body>
</html>
